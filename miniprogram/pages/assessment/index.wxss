/* ================================
   评估模块 - 优化紧凑版样式
   ================================ */

/* 页面容器 */
.assessment-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #e8f0fe 100%);
}

/* ============ 首页 - 评估类型选择 ============ */
.type-selection {
  padding: 40rpx 32rpx;
}

.page-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #666;
}

/* 评估卡片列表 */
.assessment-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.assessment-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  position: relative;
  transition: all 0.3s ease;
}

.assessment-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.card-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.pain-icon { background: linear-gradient(135deg, #ff6b6b, #ee5a5a); }
.anxiety-icon { background: linear-gradient(135deg, #ffa726, #fb8c00); }
.depression-icon { background: linear-gradient(135deg, #7c4dff, #651fff); }

.card-icon {
  font-size: 48rpx;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 4rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #999;
}

.card-badge {
  position: absolute;
  top: 16rpx;
  right: 60rpx;
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.card-time {
  position: absolute;
  top: 16rpx;
  right: 60rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.card-arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 16rpx;
}

/* 历史记录入口 */
.history-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  margin-top: 40rpx;
  background: rgba(22, 119, 255, 0.08);
  border-radius: 16rpx;
}

.history-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.history-text {
  font-size: 28rpx;
  color: #1677ff;
  font-weight: 500;
}

.history-arrow {
  color: #1677ff;
  margin-left: 8rpx;
}

/* ============ 返回头部 ============ */
.back-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.back-icon {
  font-size: 36rpx;
  color: #333;
  margin-right: 16rpx;
}

.back-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* ============ NRS评估 - 紧凑版 ============ */
.nrs-assessment {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.nrs-scroll {
  flex: 1;
  padding: 24rpx;
}

.nrs-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.optional-tag {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
  margin-left: 8rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #1677ff;
}

/* 疼痛徽章 */
.pain-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: #f5f5f5;
}

.pain-badge.none { background: #e8f5e9; }
.pain-badge.mild { background: #fff8e1; }
.pain-badge.moderate { background: #fff3e0; }
.pain-badge.severe { background: #ffebee; }

.badge-score {
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.pain-badge.none .badge-score { color: #4caf50; }
.pain-badge.mild .badge-score { color: #ff9800; }
.pain-badge.moderate .badge-score { color: #ff5722; }
.pain-badge.severe .badge-score { color: #f44336; }

.badge-text {
  font-size: 24rpx;
  color: #666;
}

/* NRS紧凑量表 */
.nrs-scale-compact {
  padding: 8rpx 0;
}

.scale-track-wrapper {
  padding: 16rpx 8rpx;
}

.scale-track {
  position: relative;
  height: 16rpx;
  background: linear-gradient(90deg, #4caf50 0%, #ffeb3b 50%, #f44336 100%);
  border-radius: 8rpx;
}

.scale-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: transparent;
  border-radius: 8rpx;
}

.scale-handle {
  position: absolute;
  top: 50%;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border: 4rpx solid #1677ff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
}

.scale-numbers {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 0 4rpx;
}

.scale-num {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.scale-num.active {
  background: #1677ff;
  color: #fff;
  font-weight: 600;
  transform: scale(1.1);
}

.scale-hints {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #999;
}

/* 身体部位网格 - 紧凑版 */
.body-areas-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.area-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  background: #fafafa;
  transition: all 0.2s ease;
}

.area-item.selected {
  border-color: #1677ff;
  background: rgba(22, 119, 255, 0.1);
}

.area-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.area-name {
  font-size: 20rpx;
  color: #333;
}

.area-item.selected .area-name {
  color: #1677ff;
  font-weight: 600;
}

/* 持续时间网格 */
.duration-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.duration-item {
  padding: 16rpx 12rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  background: #fafafa;
  text-align: center;
  transition: all 0.2s ease;
}

.duration-item.selected {
  border-color: #1677ff;
  background: rgba(22, 119, 255, 0.1);
}

.duration-text {
  font-size: 24rpx;
  color: #333;
}

.duration-item.selected .duration-text {
  color: #1677ff;
  font-weight: 600;
}

/* 触发因素网格 */
.factors-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.factor-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  background: #fafafa;
  transition: all 0.2s ease;
}

.factor-item.selected {
  border-color: #1677ff;
  background: rgba(22, 119, 255, 0.1);
}

.factor-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.factor-name {
  font-size: 20rpx;
  color: #333;
  text-align: center;
}

.factor-item.selected .factor-name {
  color: #1677ff;
  font-weight: 600;
}

/* 疼痛性质网格 */
.qualities-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quality-item {
  padding: 12rpx 20rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 32rpx;
  background: #fafafa;
  transition: all 0.2s ease;
}

.quality-item.selected {
  border-color: #1677ff;
  background: #1677ff;
}

.quality-text {
  font-size: 24rpx;
  color: #333;
}

.quality-item.selected .quality-text {
  color: #fff;
}

/* 情绪滑块 - 紧凑版 */
.emotions-compact {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.emotion-row {
  display: flex;
  align-items: center;
}

.emotion-label {
  width: 80rpx;
  font-size: 26rpx;
  color: #333;
  flex-shrink: 0;
}

.emotion-slider {
  flex: 1;
  margin: 0 16rpx;
}

.emotion-value {
  width: 48rpx;
  font-size: 28rpx;
  color: #1677ff;
  font-weight: 600;
  text-align: center;
  flex-shrink: 0;
}

/* 提交区域 */
.submit-area {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: #ccc;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  transition: all 0.3s ease;
}

.submit-btn.active {
  background: linear-gradient(135deg, #1677ff, #36a3ff);
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
}

.submit-btn.disabled {
  background: #ccc;
}

.submit-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* ============ SAS/SDS量表介绍页 ============ */
.scale-assessment {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.scale-intro {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.intro-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  max-width: 600rpx;
  width: 100%;
}

.intro-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.intro-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
}

.intro-subtitle {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 24rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  display: block;
  margin-bottom: 32rpx;
}

.intro-tips {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 40rpx;
}

.tip-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #666;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1677ff, #36a3ff);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
}
