/* ================================
   评估模块 - 优化紧凑版样式
   ================================ */

/* 页面容器 */
.assessment-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f8ff 0%, #eef3fe 50%, #e8f0fe 100%);
}

/* ============ 首页 - 评估类型选择 ============ */
.type-selection {
  padding: 40rpx 32rpx;
}

.page-header {
  text-align: center;
  margin-bottom: 56rpx;
}

.page-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #1a1a1a;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.02);
}

.page-subtitle {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

/* 评估卡片列表 */
.assessment-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.assessment-card {
  background: linear-gradient(135deg, #ffffff 0%, #fafcff 100%);
  border-radius: 28rpx;
  padding: 36rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04), 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  position: relative;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

.assessment-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(22, 119, 255, 0.02) 0%, transparent 100%);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.assessment-card:active::before {
  opacity: 1;
}

.assessment-card:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06), 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

.card-icon-wrapper {
  width: 108rpx;
  height: 108rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12), 0 4rpx 8rpx rgba(0, 0, 0, 0.08);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.assessment-card:active .card-icon-wrapper {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1), 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.pain-icon { 
  background: linear-gradient(135deg, #ff6b9d 0%, #ee5a6f 50%, #ff5252 100%);
}
.anxiety-icon { 
  background: linear-gradient(135deg, #ffa726 0%, #ff8a25 50%, #fb8c00 100%);
}
.depression-icon { 
  background: linear-gradient(135deg, #7c4dff 0%, #6a3fff 50%, #651fff 100%);
}

.card-icon {
  font-size: 52rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.2));
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.card-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.card-badge {
  position: absolute;
  top: 16rpx;
  right: 60rpx;
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.card-time {
  position: absolute;
  top: 16rpx;
  right: 60rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.card-arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 16rpx;
}

/* 历史记录入口 */
.history-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  margin-top: 40rpx;
  background: linear-gradient(135deg, rgba(22, 119, 255, 0.1) 0%, rgba(22, 119, 255, 0.05) 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(22, 119, 255, 0.15);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.history-entry:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, rgba(22, 119, 255, 0.15) 0%, rgba(22, 119, 255, 0.08) 100%);
}

.history-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.history-text {
  font-size: 28rpx;
  color: #1677ff;
  font-weight: 500;
}

.history-arrow {
  color: #1677ff;
  margin-left: 8rpx;
}

/* ============ NRS评估 - 紧凑版 ============ */
.nrs-assessment {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #e8f0fe 100%);
}

.nrs-scroll {
  flex: 1;
  padding: 28rpx;
  padding-top: 180rpx; /* 导航栏高度：状态栏(~88rpx) + 内容(88rpx) + 额外间距 = ~180rpx */
}

.nrs-section {
  background: linear-gradient(135deg, #ffffff 0%, #fafcff 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04), 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

.optional-tag {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
  margin-left: 8rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #1677ff;
}

/* 疼痛徽章 */
.pain-badge {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  background: #f5f5f5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.pain-badge.none { 
  background: linear-gradient(135deg, #e8f5e9 0%, #dcf0dd 100%);
}
.pain-badge.mild { 
  background: linear-gradient(135deg, #fff8e1 0%, #fff3cd 100%);
}
.pain-badge.moderate { 
  background: linear-gradient(135deg, #fff3e0 0%, #ffe5cc 100%);
}
.pain-badge.severe { 
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
}

.badge-score {
  font-size: 36rpx;
  font-weight: 800;
  margin-right: 8rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.pain-badge.none .badge-score { color: #2e7d32; }
.pain-badge.mild .badge-score { color: #f57c00; }
.pain-badge.moderate .badge-score { color: #e64a19; }
.pain-badge.severe .badge-score { color: #c62828; }

.badge-text {
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
}

/* NRS紧凑量表 */
.nrs-scale-compact {
  padding: 8rpx 0;
}

.scale-track-wrapper {
  padding: 16rpx 8rpx;
}

.scale-track {
  position: relative;
  height: 20rpx;
  background: linear-gradient(90deg, #4caf50 0%, #ffeb3b 50%, #f44336 100%);
  border-radius: 10rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.scale-fill {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: transparent;
  border-radius: 10rpx;
}

.scale-handle {
  position: absolute;
  top: 50%;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0f4ff 100%);
  border: 4rpx solid #1677ff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.3), 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  z-index: 10;
  transition: all 0.2s ease;
}

.scale-handle:active {
  transform: translate(-50%, -50%) scale(1.15);
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.4), 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.scale-numbers {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 0 4rpx;
}

.scale-num {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.scale-num.active {
  background: #1677ff;
  color: #fff;
  font-weight: 600;
  transform: scale(1.1);
}

.scale-hints {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #999;
}

/* 身体部位网格 - 紧凑版 */
.body-areas-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.area-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 8rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.area-item.selected {
  border-color: #1677ff;
  background: linear-gradient(135deg, rgba(22, 119, 255, 0.12) 0%, rgba(22, 119, 255, 0.08) 100%);
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.15);
  transform: scale(1.05);
}

.area-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.area-name {
  font-size: 20rpx;
  color: #333;
}

.area-item.selected .area-name {
  color: #1677ff;
  font-weight: 600;
}

/* 持续时间网格 */
.duration-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.duration-item {
  padding: 18rpx 12rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
  text-align: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.duration-item.selected {
  border-color: #1677ff;
  background: linear-gradient(135deg, rgba(22, 119, 255, 0.12) 0%, rgba(22, 119, 255, 0.08) 100%);
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.15);
  transform: translateY(-2rpx);
}

.duration-text {
  font-size: 24rpx;
  color: #333;
}

.duration-item.selected .duration-text {
  color: #1677ff;
  font-weight: 600;
}

/* 触发因素网格 */
.factors-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.factor-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 8rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.factor-item.selected {
  border-color: #1677ff;
  background: linear-gradient(135deg, rgba(22, 119, 255, 0.12) 0%, rgba(22, 119, 255, 0.08) 100%);
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.15);
  transform: scale(1.05);
}

.factor-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.factor-name {
  font-size: 20rpx;
  color: #333;
  text-align: center;
}

.factor-item.selected .factor-name {
  color: #1677ff;
  font-weight: 600;
}

/* 疼痛性质网格 */
.qualities-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quality-item {
  padding: 14rpx 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.quality-item.selected {
  border-color: #1677ff;
  background: linear-gradient(135deg, #1677ff 0%, #36a3ff 100%);
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.3);
  transform: translateY(-2rpx);
}

.quality-text {
  font-size: 24rpx;
  color: #333;
}

.quality-item.selected .quality-text {
  color: #fff;
}

/* 情绪滑块 - 紧凑版 */
.emotions-compact {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.emotion-row {
  display: flex;
  align-items: center;
}

.emotion-label {
  width: 80rpx;
  font-size: 26rpx;
  color: #333;
  flex-shrink: 0;
}

.emotion-slider {
  flex: 1;
  margin: 0 16rpx;
}

.emotion-value {
  width: 48rpx;
  font-size: 28rpx;
  color: #1677ff;
  font-weight: 600;
  text-align: center;
  flex-shrink: 0;
}

/* 提交区域 */
.submit-area {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background: #ccc;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 2rpx;
}

.submit-btn.active {
  background: linear-gradient(135deg, #1677ff 0%, #36a3ff 100%);
  box-shadow: 0 8rpx 28rpx rgba(22, 119, 255, 0.35), 0 4rpx 12rpx rgba(22, 119, 255, 0.2);
  transform: translateY(-2rpx);
}

.submit-btn.active:active {
  transform: translateY(0) scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, 0.3), 0 2rpx 8rpx rgba(22, 119, 255, 0.15);
}

.submit-btn.disabled {
  background: #ccc;
}

.submit-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* ============ SAS/SDS量表介绍页 ============ */
.scale-assessment {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f8ff 0%, #eef3fe 50%, #e8f0fe 100%);
}

.scale-intro {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  padding-top: 140rpx; /* 导航栏 + 额外间距 */
}

.intro-card {
  background: linear-gradient(135deg, #ffffff 0%, #fafcff 100%);
  border-radius: 36rpx;
  padding: 56rpx;
  text-align: center;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.08), 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  max-width: 600rpx;
  width: 100%;
}

.intro-icon {
  font-size: 88rpx;
  margin-bottom: 28rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.15));
}

.intro-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #1a1a1a;
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.intro-subtitle {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 28rpx;
  font-weight: 500;
}

.intro-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.7;
  display: block;
  margin-bottom: 36rpx;
}

.intro-tips {
  display: flex;
  justify-content: center;
  gap: 36rpx;
  margin-bottom: 48rpx;
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, rgba(22, 119, 255, 0.04) 0%, rgba(22, 119, 255, 0.02) 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(22, 119, 255, 0.1);
}

.tip-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tip-icon {
  font-size: 36rpx;
  margin-bottom: 10rpx;
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.1));
}

.tip-text {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.start-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a3ff 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(22, 119, 255, 0.35), 0 4rpx 12rpx rgba(22, 119, 255, 0.2);
  letter-spacing: 2rpx;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.start-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, 0.3), 0 2rpx 8rpx rgba(22, 119, 255, 0.15);
}
