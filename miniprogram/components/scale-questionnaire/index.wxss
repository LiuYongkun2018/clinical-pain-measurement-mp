/* components/scale-questionnaire/index.wxss */
/* 通用量表测评组件样式 */

.questionnaire-container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ==================== 进度条区域 ==================== */
.progress-section {
  margin-bottom: 24rpx;
}

.progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #52c41a, #73d13d);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.progress-percent {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ==================== 题目导航点 ==================== */
.question-dots {
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
  padding: 16rpx 0;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.dot {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  transition: all 0.3s ease;
}

.dot.answered {
  background: rgba(82, 196, 26, 0.8);
  color: white;
}

.dot.active {
  background: #1677ff;
  color: white;
  transform: scale(1.15);
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.4);
}

/* ==================== 题目卡片 ==================== */
.question-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.question-card.animating {
  transform: scale(0.98);
  opacity: 0.9;
}

.question-number {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.number-badge {
  background: linear-gradient(135deg, #1677ff, #69b7ff);
  color: white;
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.reverse-badge {
  background: rgba(250, 173, 20, 0.15);
  color: #d48806;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(250, 173, 20, 0.3);
}

.question-content {
  margin-bottom: 32rpx;
}

.question-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.6;
  display: block;
}

.question-dimension {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

/* ==================== 选项列表 ==================== */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.option-item:active {
  transform: scale(0.98);
}

.option-item.selected {
  background: rgba(22, 119, 255, 0.08);
  border-color: #1677ff;
}

.option-radio {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #d9d9d9;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.option-radio.checked {
  border-color: #1677ff;
  background: #1677ff;
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  background: white;
  border-radius: 50%;
}

.option-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.option-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #1677ff;
  background: rgba(22, 119, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.option-item.selected .option-score {
  background: #1677ff;
  color: white;
}

.option-label {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* ==================== 导航按钮 ==================== */
.navigation-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.nav-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.nav-btn::after {
  border: none;
}

.prev-btn {
  background: rgba(255, 255, 255, 0.9);
  color: #666;
}

.prev-btn.disabled {
  opacity: 0.5;
}

.next-btn {
  background: linear-gradient(135deg, #1677ff, #69b7ff);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, 0.3);
}

.submit-btn {
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(82, 196, 26, 0.3);
}

.submit-btn.disabled {
  background: #d9d9d9;
  box-shadow: none;
}

.nav-icon {
  font-size: 28rpx;
}

.nav-text {
  font-size: 28rpx;
}

.hidden {
  display: none !important;
}

/* ==================== 未答题提示 ==================== */
.unanswered-hint {
  text-align: center;
  margin-top: 20rpx;
}

.hint-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(250, 173, 20, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

/* ==================== 结果页面 ==================== */
.result-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  width: 100%;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.result-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.result-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: white;
  margin: 0 auto 20rpx;
}

.result-icon.normal {
  background: linear-gradient(135deg, #52c41a, #73d13d);
}

.result-icon.mild {
  background: linear-gradient(135deg, #faad14, #ffc53d);
}

.result-icon.moderate {
  background: linear-gradient(135deg, #fa8c16, #ffa940);
}

.result-icon.severe {
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

/* 分数区域 */
.score-section {
  text-align: center;
  margin-bottom: 24rpx;
}

.score-main {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.score-number {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
}

.score-number.normal {
  color: #52c41a;
}

.score-number.mild {
  color: #faad14;
}

.score-number.moderate {
  color: #fa8c16;
}

.score-number.severe {
  color: #ff4d4f;
}

.score-unit {
  font-size: 32rpx;
  color: #999;
  font-weight: 500;
}

.score-label {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

/* 等级徽章 */
.level-badge {
  text-align: center;
  margin: 24rpx auto;
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  display: inline-block;
  width: fit-content;
}

.level-badge.normal {
  background: rgba(82, 196, 26, 0.1);
  border: 2rpx solid rgba(82, 196, 26, 0.3);
}

.level-badge.mild {
  background: rgba(250, 173, 20, 0.1);
  border: 2rpx solid rgba(250, 173, 20, 0.3);
}

.level-badge.moderate {
  background: rgba(250, 140, 22, 0.1);
  border: 2rpx solid rgba(250, 140, 22, 0.3);
}

.level-badge.severe {
  background: rgba(255, 77, 79, 0.1);
  border: 2rpx solid rgba(255, 77, 79, 0.3);
}

.level-text {
  font-size: 32rpx;
  font-weight: 600;
}

.level-badge.normal .level-text {
  color: #52c41a;
}

.level-badge.mild .level-text {
  color: #faad14;
}

.level-badge.moderate .level-text {
  color: #fa8c16;
}

.level-badge.severe .level-text {
  color: #ff4d4f;
}

/* 建议区域 */
.suggestion-section {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 32rpx 0;
}

.suggestion-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.suggestion-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* 分数详情 */
.score-details {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin: 24rpx 0;
}

.detail-item {
  text-align: center;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 操作按钮 */
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn::after {
  border: none;
}

.save-btn {
  background: linear-gradient(135deg, #1677ff, #69b7ff);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, 0.3);
}

.restart-btn {
  background: #f5f5f5;
  color: #666;
}

.btn-icon {
  font-size: 32rpx;
}

/* 免责声明 */
.disclaimer {
  margin-top: 32rpx;
  padding: 20rpx;
  background: rgba(250, 173, 20, 0.1);
  border-radius: 12rpx;
  border: 1rpx solid rgba(250, 173, 20, 0.2);
}

.disclaimer-text {
  font-size: 24rpx;
  color: #d48806;
  line-height: 1.6;
}
