/* 全局通用样式 - 提取的公共样式 */

/* ==================== CSS 变量定义 ==================== */
page {
  /* 主题色 */
  --primary-color: #1677ff;
  --primary-light: #69b7ff;
  --primary-dark: #0958d9;
  
  /* 渐变色 */
  --gradient-purple-start: #667eea;
  --gradient-purple-end: #764ba2;
  --gradient-blue: linear-gradient(135deg, #1677ff 0%, #69b7ff 100%);
  --gradient-purple: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  
  /* 功能色 */
  --success-color: #52c41a;
  --warning-color: #faad14;
  --error-color: #ff4d4f;
  --info-color: #1890ff;
  
  /* 文字颜色 */
  --text-primary: #333;
  --text-secondary: #666;
  --text-tertiary: #999;
  --text-disabled: #ccc;
  
  /* 背景色 */
  --bg-white: #ffffff;
  --bg-gray-light: #f5f5f5;
  --bg-gray: #e8e8e8;
  
  /* 圆角 */
  --radius-small: 8rpx;
  --radius-medium: 16rpx;
  --radius-large: 24rpx;
  --radius-round: 50%;
  
  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 40rpx;
  
  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  
  /* 过渡 */
  --transition-fast: all 0.2s ease;
  --transition-normal: all 0.3s ease;
  --transition-slow: all 0.5s ease;
}

/* ==================== 通用卡片样式 ==================== */
.card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: var(--radius-large);
  box-shadow: var(--shadow-lg);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  padding: var(--spacing-xl);
  margin: 0 30rpx var(--spacing-xl);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-md);
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 24rpx;
  background: var(--gradient-blue);
  border-radius: 4rpx;
}

.card-body {
  padding: var(--spacing-md) 0;
}

/* ==================== 通用按钮样式 ==================== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) var(--spacing-lg);
  border-radius: var(--radius-medium);
  font-size: 28rpx;
  font-weight: 500;
  transition: var(--transition-normal);
  border: none;
  outline: none;
}

.btn-primary {
  background: var(--gradient-blue);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.3);
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(22, 119, 255, 0.3);
}

.btn-secondary {
  background: var(--bg-gray-light);
  color: var(--text-primary);
}

.btn-secondary:active {
  background: var(--bg-gray);
}

.btn-success {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(82, 196, 26, 0.3);
}

.btn-danger {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ==================== 通用布局 ==================== */
.container {
  padding: var(--spacing-lg);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-sm);
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-sm);
}

/* ==================== 通用文本样式 ==================== */
.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}

.text-error {
  color: var(--error-color);
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-bold {
  font-weight: 600;
}

.text-xl {
  font-size: 36rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-md {
  font-size: 28rpx;
}

.text-sm {
  font-size: 24rpx;
}

.text-xs {
  font-size: 20rpx;
}

/* ==================== 通用间距 ==================== */
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }

.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }

.pt-xs { padding-top: var(--spacing-xs); }
.pt-sm { padding-top: var(--spacing-sm); }
.pt-md { padding-top: var(--spacing-md); }
.pt-lg { padding-top: var(--spacing-lg); }
.pt-xl { padding-top: var(--spacing-xl); }

.pb-xs { padding-bottom: var(--spacing-xs); }
.pb-sm { padding-bottom: var(--spacing-sm); }
.pb-md { padding-bottom: var(--spacing-md); }
.pb-lg { padding-bottom: var(--spacing-lg); }
.pb-xl { padding-bottom: var(--spacing-xl); }

/* ==================== 通用标签样式 ==================== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-medium);
  font-size: 24rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(22, 119, 255, 0.1);
  color: var(--primary-color);
  border: 1rpx solid rgba(22, 119, 255, 0.2);
}

.tag-success {
  background: rgba(82, 196, 26, 0.1);
  color: var(--success-color);
  border: 1rpx solid rgba(82, 196, 26, 0.2);
}

.tag-warning {
  background: rgba(250, 173, 20, 0.1);
  color: var(--warning-color);
  border: 1rpx solid rgba(250, 173, 20, 0.2);
}

.tag-error {
  background: rgba(255, 77, 79, 0.1);
  color: var(--error-color);
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

/* ==================== 通用加载状态 ==================== */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.1);
  border-top-color: var(--primary-color);
  border-radius: var(--radius-round);
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--spacing-md);
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ==================== 通用空状态 ==================== */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) var(--spacing-lg);
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-sm);
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ==================== 通用分割线 ==================== */
.divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.05);
  margin: var(--spacing-md) 0;
}

.divider-thick {
  height: 2rpx;
  background: rgba(0, 0, 0, 0.08);
}

/* ==================== 通用渐变背景 ==================== */
.gradient-purple {
  background: var(--gradient-purple);
}

.gradient-blue {
  background: var(--gradient-blue);
}

/* ==================== 毛玻璃效果 ==================== */
.glass-effect {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* ==================== 悬浮效果 ==================== */
.hover-lift {
  transition: var(--transition-normal);
}

.hover-lift:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-md);
}

/* ==================== 安全区域适配 ==================== */
.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ==================== 响应式隐藏 ==================== */
.hidden {
  display: none !important;
}

.visible {
  display: block !important;
}
